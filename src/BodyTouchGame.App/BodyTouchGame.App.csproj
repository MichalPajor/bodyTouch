<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>BodyTouchGame.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- HybridWebView (3D view) uses dynamic System.Text.Json for InvokeDotNet; it is disabled in trimmed builds
		     unless enabled explicitly. Our own payloads use the source-generated BridgeJsonContext. -->
		<MauiHybridWebViewSupported>true</MauiHybridWebViewSupported>

		<!-- Display name -->
		<ApplicationTitle>Body Touch Game</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>place.yourmoment.bodytouchgame</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- API 23 (Android 6.0): required by Google Mobile Ads / Play Billing (stage 11). -->
		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.8" Color="#0D0A1A" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D0A1A" BaseSize="160,160" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Rendered at 3x by tools/blender/render_start_image.py -->
		<MauiImage Update="Resources\Images\start_mannequin.png" Resize="True" BaseSize="210,340" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- sqlite-net maps entity classes by reflection: keep BodyTouchGame.Data intact in trimmed Release builds. -->
		<TrimmerRootAssembly Include="BodyTouchGame.Data" RootMode="All" />
	</ItemGroup>

	<ItemGroup>
		<!-- UI strings (Polish by default). The strongly typed AppResources class is generated at build time. -->
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>BodyTouchGame.App.Resources.Strings</StronglyTypedNamespace>
			<StronglyTypedClassName>AppResources</StronglyTypedClassName>
			<StronglyTypedFileName>$(IntermediateOutputPath)AppResources.Designer.cs</StronglyTypedFileName>
			<StronglyTypedManifestPrefix>BodyTouchGame.App.Resources.Strings</StronglyTypedManifestPrefix>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Stage 11: AdMob interstitials, Plugin.InAppBilling ("remove_ads", as in testowy2), Google Play In-App Review. -->
		<PackageReference Include="Xamarin.GooglePlayServices.Ads.Lite" Version="124.0.0.9" />
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<PackageReference Include="Xamarin.Google.Android.Play.Review" Version="2.0.2.10" />
		<PackageReference Include="Xamarin.Google.UserMessagingPlatform" Version="4.0.0.4" />
		<!-- The Google libraries bring AndroidX.Fragment 1.9 (Kotlin extensions merged into it); MAUI references
		     Fragment.Ktx 1.8, whose classes would be duplicated – use the matching 1.9 package. Lifecycle.Process and
		     Tracing.Ktx are aligned with the newer Lifecycle / Tracing versions the same way. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\BodyTouchGame.Core\BodyTouchGame.Core.csproj" />
	  <ProjectReference Include="..\BodyTouchGame.Geometry\BodyTouchGame.Geometry.csproj" />
	  <ProjectReference Include="..\BodyTouchGame.Data\BodyTouchGame.Data.csproj" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>BodyTouchGame.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- HybridWebView (3D view) uses dynamic System.Text.Json for InvokeDotNet; it is disabled in trimmed builds
		     unless enabled explicitly. Our own payloads use the source-generated BridgeJsonContext. -->
		<MauiHybridWebViewSupported>true</MauiHybridWebViewSupported>

		<!-- Display name -->
		<ApplicationTitle>Body Touch Game</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.example.bodytouchgame</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0D0A1A" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D0A1A" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Rendered at 3x by tools/blender/render_start_image.py -->
		<MauiImage Update="Resources\Images\start_mannequin.png" Resize="True" BaseSize="210,340" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- sqlite-net maps entity classes by reflection: keep BodyTouchGame.Data intact in trimmed Release builds. -->
		<TrimmerRootAssembly Include="BodyTouchGame.Data" RootMode="All" />
	</ItemGroup>

	<ItemGroup>
		<!-- UI strings (Polish by default). The strongly typed AppResources class is generated at build time. -->
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>BodyTouchGame.App.Resources.Strings</StronglyTypedNamespace>
			<StronglyTypedClassName>AppResources</StronglyTypedClassName>
			<StronglyTypedFileName>$(IntermediateOutputPath)AppResources.Designer.cs</StronglyTypedFileName>
			<StronglyTypedManifestPrefix>BodyTouchGame.App.Resources.Strings</StronglyTypedManifestPrefix>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\BodyTouchGame.Core\BodyTouchGame.Core.csproj" />
	  <ProjectReference Include="..\BodyTouchGame.Geometry\BodyTouchGame.Geometry.csproj" />
	  <ProjectReference Include="..\BodyTouchGame.Data\BodyTouchGame.Data.csproj" />
	</ItemGroup>

</Project>

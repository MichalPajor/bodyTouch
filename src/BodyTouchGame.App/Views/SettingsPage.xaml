<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings screen (mockup 10). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BodyTouchGame.App.Controls"
             xmlns:vm="clr-namespace:BodyTouchGame.App.ViewModels"
             xmlns:res="clr-namespace:BodyTouchGame.App.Resources.Strings"
             x:Class="BodyTouchGame.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">
    <Grid>
        <controls:ConfettiBackground />

        <!-- Scrolls on short screens. -->
        <ScrollView x:Name="Scroller">
        <Grid x:Name="ContentGrid" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16" Padding="20,12,20,16">
            <Label Text="{x:Static res:AppResources.Settings}" Style="{StaticResource ScreenTitle}" />

            <Label Grid.Row="1" Text="{x:Static res:AppResources.SectionGame}" Style="{StaticResource SectionHeader}" TextColor="{StaticResource PartyPink}" />
            <Border Grid.Row="2" Padding="0">
                <VerticalStackLayout>
                    <controls:SettingsRow Text="{x:Static res:AppResources.DefaultConfig}" Command="{Binding DefaultConfigCommand}" />
                    <controls:SettingsRow Text="{x:Static res:AppResources.ZoneEditor}" Command="{Binding ZoneEditorCommand}" />
                    <controls:SettingsRow Text="{x:Static res:AppResources.ExcludedZones}" Command="{Binding ExcludedZonesCommand}" />
                    <controls:SettingsRow Text="{x:Static res:AppResources.HowToPlaySettings}" Command="{Binding HowToPlayCommand}" ShowDivider="False" />
                </VerticalStackLayout>
            </Border>

            <Label Grid.Row="3" Text="{x:Static res:AppResources.SectionEffects}" Style="{StaticResource SectionHeader}" TextColor="{StaticResource PartyCyan}" />
            <Border Grid.Row="4" Padding="0">
                <VerticalStackLayout>
                    <controls:SettingsToggleRow Text="{x:Static res:AppResources.Sounds}" IsToggled="{Binding SoundEnabled}" />
                    <controls:SettingsToggleRow Text="{x:Static res:AppResources.ConfettiOnHit}" IsToggled="{Binding ConfettiEnabled}" ShowDivider="False" />
                </VerticalStackLayout>
            </Border>

            <Label Grid.Row="5" Text="{x:Static res:AppResources.SectionLanguage}" Style="{StaticResource SectionHeader}" TextColor="{StaticResource PartyViolet}" />
            <Border Grid.Row="6" Padding="0">
                <controls:SettingsRow Text="{Binding LanguageText}" Command="{Binding LanguageCommand}" ShowDivider="False" />
            </Border>

            <Label Grid.Row="7" Text="{x:Static res:AppResources.SectionShop}" Style="{StaticResource SectionHeader}" TextColor="{StaticResource Primary}" />
            <Border Grid.Row="8" Padding="0">
                <VerticalStackLayout>
                    <controls:SettingsRow Text="{Binding RemoveAdsText}" Command="{Binding RemoveAdsCommand}" IsVisible="{Binding CanBuy}" />
                    <Grid Padding="16,0" HeightRequest="60" IsVisible="{Binding AdsRemoved}">
                        <Label Text="{x:Static res:AppResources.AdsRemoved}" FontFamily="{StaticResource FontBold}" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                    <controls:SettingsRow Text="{x:Static res:AppResources.RestorePurchase}" Command="{Binding RestorePurchaseCommand}" IsVisible="{Binding CanBuy}" />
                    <controls:SettingsRow Text="{x:Static res:AppResources.AdPrivacy}" Command="{Binding AdPrivacyCommand}" />
                    <controls:SettingsRow Text="{x:Static res:AppResources.RateApp}" Command="{Binding RateAppCommand}" ShowDivider="False" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        </ScrollView>
    </Grid>
</ContentPage>

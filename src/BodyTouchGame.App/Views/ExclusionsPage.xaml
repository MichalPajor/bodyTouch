<?xml version="1.0" encoding="utf-8" ?>
<!-- Excluded zones per player (Settings → Strefy wykluczone). Tap a zone on the model to exclude / restore it. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BodyTouchGame.App.Controls"
             xmlns:vm="clr-namespace:BodyTouchGame.App.ViewModels"
             xmlns:res="clr-namespace:BodyTouchGame.App.Resources.Strings"
             x:Class="BodyTouchGame.App.Views.ExclusionsPage"
             x:DataType="vm:ExclusionsViewModel">
    <Grid>
        <controls:ConfettiBackground />

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12" Padding="20,12,20,16">
            <Label Text="{x:Static res:AppResources.ExcludedZones}" Style="{StaticResource ScreenTitle}" />

            <Label Grid.Row="1" Text="{x:Static res:AppResources.ExclusionsHint}" FontSize="13" TextColor="{StaticResource Muted}" IsVisible="{Binding HasPlayers}" />
            <Label Grid.Row="1" Text="{x:Static res:AppResources.NoPlayersYet}" FontSize="15" IsVisible="{Binding HasNoPlayers}" />

            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasPlayers}">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Players}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExclusionPlayerItem">
                            <controls:ChoiceButton Text="{Binding Name}" IsSelected="{Binding IsSelected}" ButtonHeight="44"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExclusionsViewModel}}, Path=SelectPlayerCommand, x:DataType=vm:ExclusionsViewModel}"
                                                   CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <HorizontalStackLayout Grid.Row="3" BindableLayout.ItemsSource="{Binding Levels}" Spacing="6" IsVisible="{Binding HasPlayers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LevelItem">
                        <controls:ChoiceButton Text="{Binding Name}" IsSelected="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" IsOption="True" ButtonHeight="40"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExclusionsViewModel}}, Path=SelectLevelCommand, x:DataType=vm:ExclusionsViewModel}"
                                               CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <controls:BodyView x:Name="Body" Grid.Row="4" IsVisible="{Binding HasPlayers}" />

            <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasPlayers}">
                <Label Text="{Binding ExcludedText}" FontSize="13" TextColor="{StaticResource Muted}" VerticalOptions="Center" MaxLines="3" LineBreakMode="TailTruncation" />
                <Button Grid.Column="1" Text="{x:Static res:AppResources.ClearExclusions}" Command="{Binding ClearCommand}" HeightRequest="44" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

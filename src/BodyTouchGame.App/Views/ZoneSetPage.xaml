<?xml version="1.0" encoding="utf-8" ?>
<!-- Zone set of the game: any mix of levels, zones picked on the model and custom points (spec 6). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BodyTouchGame.App.Controls"
             xmlns:vm="clr-namespace:BodyTouchGame.App.ViewModels"
             xmlns:res="clr-namespace:BodyTouchGame.App.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="BodyTouchGame.App.Views.ZoneSetPage"
             x:DataType="vm:ZoneSetViewModel">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="Not" />
    </ContentPage.Resources>
    <Grid>
        <controls:ConfettiBackground />

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10" Padding="20,12,20,16">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static res:AppResources.NewGameStep2}" Style="{StaticResource Caption}" />
                <Label Text="{x:Static res:AppResources.Zones}" Style="{StaticResource ScreenTitle}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <Label Text="{x:Static res:AppResources.ZoneSetHint}" FontSize="13" TextColor="{StaticResource Muted}" />
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Levels}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LevelItem">
                            <controls:ChoiceButton Text="{Binding Name}" IsSelected="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" ButtonHeight="40"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ZoneSetViewModel}}, Path=ToggleCommand, x:DataType=vm:ZoneSetViewModel}"
                                                   CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
                <Label Text="{x:Static res:AppResources.ManualZonesHint}" FontSize="12" TextColor="{StaticResource Muted}" />
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TapLevels}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LevelItem">
                            <controls:ChoiceButton Text="{Binding Name}" IsSelected="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" IsOption="True" ButtonHeight="34"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ZoneSetViewModel}}, Path=SelectTapLevelCommand, x:DataType=vm:ZoneSetViewModel}"
                                                   CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <controls:BodyView x:Name="Body" Grid.Row="2" />

            <VerticalStackLayout Grid.Row="3" Spacing="8">
                <!-- Always laid out (shown with Opacity), so tapping a zone on the model does not resize the 3D view. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Opacity="0" InputTransparent="{Binding HasManual, Converter={StaticResource Not}}">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding HasManual}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Label Text="{Binding ManualText}" FontSize="13" TextColor="{StaticResource PartyCyan}" MaxLines="2" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{x:Static res:AppResources.ClearManual}" HeightRequest="40" MinimumHeightRequest="40" Command="{Binding ClearManualCommand}" />
                </Grid>
                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasPoints}">
                    <Label Text="{x:Static res:AppResources.CustomPointsLabel}" Style="{StaticResource Caption}" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Points}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoiceItem">
                                    <controls:ChoiceButton Text="{Binding Name}" IsSelected="{Binding IsSelected}" IsOption="True" ButtonHeight="34"
                                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ZoneSetViewModel}}, Path=TogglePointCommand, x:DataType=vm:ZoneSetViewModel}"
                                                           CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
                <Label Text="{Binding CountText}" FontFamily="{StaticResource FontBold}" FontSize="14" />
            </VerticalStackLayout>

            <controls:PartyButton Grid.Row="4" Text="{x:Static res:AppResources.Done}" Command="{Binding DoneCommand}" Margin="0,0,-5,-5" />
        </Grid>
    </Grid>
</ContentPage>

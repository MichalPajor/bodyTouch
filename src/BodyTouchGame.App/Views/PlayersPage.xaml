<?xml version="1.0" encoding="utf-8" ?>
<!-- Players (own design D7, in the style of mockup 2): list with statistics, add, open the profile. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BodyTouchGame.App.Controls"
             xmlns:vm="clr-namespace:BodyTouchGame.App.ViewModels"
             xmlns:res="clr-namespace:BodyTouchGame.App.Resources.Strings"
             x:Class="BodyTouchGame.App.Views.PlayersPage"
             x:DataType="vm:PlayersViewModel">
    <Grid>
        <controls:ConfettiBackground />

        <Grid RowDefinitions="Auto,*" RowSpacing="16" Padding="20,12,20,16">
            <Label Text="{x:Static res:AppResources.Players}" Style="{StaticResource ScreenTitle}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.NoPlayers}" FontSize="15" TextColor="{StaticResource Muted}" IsVisible="{Binding IsEmpty}" Margin="0,0,0,8" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlayerListItem">
                                <Border HeightRequest="68" Padding="14,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlayersViewModel}}, Path=OpenCommand, x:DataType=vm:PlayersViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <controls:Avatar Name="{Binding Name}" Color="{Binding Color}" Emoji="{Binding Emoji}" Size="42" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontFamily="{StaticResource FontBold}" FontSize="16" />
                                            <Label Text="{Binding Stats}" FontSize="12" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <controls:LineIcon Grid.Column="2" Data="M9 5 L16 12 L9 19" StrokeColor="{StaticResource Muted}" StrokeWidth="2.2" IconSize="18" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid HeightRequest="56">
                        <Rectangle Stroke="#4A4170" StrokeThickness="2" StrokeDashArray="4,3" Fill="Transparent" />
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <controls:LineIcon Data="M12 5 V19 M5 12 H19" StrokeColor="{StaticResource Text}" StrokeWidth="2.5" IconSize="18" VerticalOptions="Center" />
                            <Label Text="{x:Static res:AppResources.AddPlayer}" FontFamily="{StaticResource FontBold}" FontSize="15" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddPlayerCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

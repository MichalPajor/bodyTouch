<?xml version="1.0" encoding="utf-8" ?>
<!-- The game: every round state (mockups 4–8, WhoIsNext = own design D7) and the session summary (mockup 9).
     One 3D view is shared by Draw, Guessing and Reveal; the other states cover it with an opaque layer. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BodyTouchGame.App.Controls"
             xmlns:vm="clr-namespace:BodyTouchGame.App.ViewModels"
             xmlns:res="clr-namespace:BodyTouchGame.App.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="BodyTouchGame.App.Views.GamePage"
             x:DataType="vm:GameViewModel">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="Not" />
        <Style x:Key="BigTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontTitle}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="0.9" />
        </Style>
        <Style x:Key="SubTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontBold}" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <controls:ConfettiBackground />

        <!-- ============ Layer 1: header + 3D panel + footer (Draw, Guessing, Reveal) ============ -->
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Padding="20,12,20,16">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowHeader}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Header}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding SubHeader}" Style="{StaticResource SubTitle}" IsVisible="{Binding ShowProgress}" />
                    <Label Text="{x:Static res:AppResources.WhereTouched}" FontFamily="{StaticResource FontTitle}" FontSize="24" LineHeight="0.9"
                           IsVisible="{Binding IsGuessing}" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding Progress}" Spacing="4" VerticalOptions="Start" Margin="0,12,0,0"
                                       IsVisible="{Binding ShowProgress}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProgressSegment">
                            <BoxView Color="{Binding Color}" WidthRequest="{Binding Width}" HeightRequest="6" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
                <Border Grid.Column="1" BackgroundColor="{StaticResource PartyCyan}" StrokeThickness="0" Padding="12,6" VerticalOptions="Start"
                        IsVisible="{Binding HasGuessTimer}">
                    <Label Text="{Binding GuessTimerText}" FontFamily="{StaticResource FontExtraBold}" FontSize="17" TextColor="{StaticResource OnPrimary}" />
                </Border>
            </Grid>

            <!-- 3D panel -->
            <Border Grid.Row="1" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Draw: target -->
                    <VerticalStackLayout Spacing="4" Padding="16,18,16,0" IsVisible="{Binding IsDraw}">
                        <Label Text="{Binding TargetTitle}" FontFamily="{StaticResource FontBold}" FontSize="13" CharacterSpacing="1.5"
                               TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding TargetName}" Style="{StaticResource BigTitle}" FontSize="{Binding TargetNameSize}" TextColor="{StaticResource Primary}" IsVisible="{Binding ShowTargetHint, Converter={StaticResource Not}}" />
                        <Label Text="{x:Static res:AppResources.ChooseTargetHint}" FontFamily="{StaticResource FontBold}" FontSize="18" TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" IsVisible="{Binding ShowTargetHint}" />
                    </VerticalStackLayout>
                    <!-- Reveal: distance, points, comment -->
                    <VerticalStackLayout Spacing="6" Padding="16,18,16,0" IsVisible="{Binding IsReveal}">
                        <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Label Text="{Binding DistanceText}" FontFamily="{StaticResource FontTitle}" FontSize="38" VerticalOptions="Center" />
                            <controls:PartyButton Text="{Binding PointsText}" ButtonHeight="34" FontSize="15" ShadowOffset="4" VerticalOptions="Center" InputTransparent="True" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding CommentText}" FontSize="14" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <controls:BodyView x:Name="Body" Grid.Row="1" IsFramed="False" />

                    <!-- Reveal: legend -->
                    <FlexLayout Grid.Row="2" Wrap="Wrap" JustifyContent="Center" Padding="12,0,12,10" IsVisible="{Binding IsReveal}">
                        <HorizontalStackLayout Spacing="6" Margin="8,0,8,4">
                            <Ellipse Fill="{StaticResource Pin}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                            <Label Text="{Binding LegendPin}" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6" Margin="8,0,8,4">
                            <Ellipse Stroke="{StaticResource Primary}" StrokeThickness="2" WidthRequest="11" HeightRequest="11" VerticalOptions="Center" />
                            <Label Text="{Binding LegendTarget}" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </FlexLayout>
                </Grid>
            </Border>

            <!-- Footer: Draw -->
            <VerticalStackLayout Grid.Row="2" Spacing="12" IsVisible="{Binding IsDraw}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <controls:InfoTile Caption="{x:Static res:AppResources.TileTouch}" Value="{Binding TouchText}" AccentColor="{StaticResource PartyPink}" />
                    <controls:InfoTile Grid.Column="1" Caption="{x:Static res:AppResources.TileMovement}" Value="{Binding MovementText}" AccentColor="{StaticResource PartyCyan}" />
                    <controls:InfoTile Grid.Column="2" Caption="{x:Static res:AppResources.TileTime}" Value="{Binding TimeText}" AccentColor="{StaticResource PartyViolet}" />
                </Grid>
                <controls:PartyButton Text="{x:Static res:AppResources.StartTouch}" Command="{Binding StartTouchCommand}" Margin="0,0,-5,-5" />
            </VerticalStackLayout>

            <!-- Footer: Guessing -->
            <VerticalStackLayout Grid.Row="2" Spacing="12" IsVisible="{Binding IsGuessing}">
                <Border Padding="0">
                    <Grid ColumnDefinitions="3,*,Auto">
                        <BoxView Color="{StaticResource Pin}" />
                        <VerticalStackLayout Grid.Column="1" Padding="16,10" Spacing="2">
                            <Label Text="{x:Static res:AppResources.YourPin}" FontSize="13" TextColor="{StaticResource Muted}" />
                            <Label Text="{Binding PinText}" FontFamily="{StaticResource FontBold}" FontSize="15" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{x:Static res:AppResources.HoldToMove}" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center"
                               Margin="0,0,14,0" IsVisible="{Binding HasPin}" />
                    </Grid>
                </Border>
                <controls:PartyButton Text="{x:Static res:AppResources.Confirm}" Command="{Binding ConfirmCommand}" Margin="0,0,-5,-5" />
            </VerticalStackLayout>

            <!-- Footer: Reveal -->
            <VerticalStackLayout Grid.Row="2" Spacing="12" IsVisible="{Binding IsReveal}">
                <controls:AccentRow Caption="{Binding GuesserName}" Value="{Binding TotalText}" AccentColor="{StaticResource PartyCyan}" />
                <controls:PartyButton Text="{Binding NextButtonText}" Command="{Binding NextRoundCommand}" Margin="0,0,-5,-5" />
            </VerticalStackLayout>
        </Grid>

        <!-- ============ Layer 2: opaque screens without the model ============ -->
        <Grid IsVisible="{Binding ShowOverlay}" BackgroundColor="{StaticResource Background}">
            <controls:ConfettiBackground />

            <!-- WhoIsNext (D7) -->
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16" Padding="20,12,20,16" IsVisible="{Binding IsWhoIsNext}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Header}" Style="{StaticResource Caption}" />
                    <HorizontalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding Progress}" Spacing="4" VerticalOptions="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgressSegment">
                                <BoxView Color="{Binding Color}" WidthRequest="{Binding Width}" HeightRequest="6" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="14" VerticalOptions="Center">
                    <Border Padding="0">
                        <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="0">
                            <BoxView Color="{StaticResource PartyCyan}" />
                            <controls:Avatar Grid.Column="1" Name="{Binding GuesserName}" Color="{Binding GuesserColor}" Emoji="{Binding GuesserEmoji}" Size="64" Margin="16" />
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding GuesserName}" FontFamily="{StaticResource FontTitle}" FontSize="26" LineBreakMode="TailTruncation" />
                                <Label Text="{x:Static res:AppResources.WhoGuesses}" FontFamily="{StaticResource FontBold}" FontSize="13" CharacterSpacing="1" TextColor="{StaticResource PartyCyan}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Padding="0">
                        <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="0">
                            <BoxView Color="{StaticResource PartyPink}" />
                            <controls:Avatar Grid.Column="1" Name="{Binding ModelName}" Color="{Binding ModelColor}" Emoji="{Binding ModelEmoji}" Size="64" Margin="16" />
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding ModelName}" FontFamily="{StaticResource FontTitle}" FontSize="26" LineBreakMode="TailTruncation" />
                                <Label Text="{x:Static res:AppResources.WhoTouches}" FontFamily="{StaticResource FontBold}" FontSize="13" CharacterSpacing="1" TextColor="{StaticResource PartyPink}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Label Text="{Binding WhoIsNextHint}" FontSize="15" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <controls:InfoTile Caption="{x:Static res:AppResources.TileTouch}" Value="{Binding TouchText}" AccentColor="{StaticResource PartyPink}" />
                    <controls:InfoTile Grid.Column="1" Caption="{x:Static res:AppResources.TileMovement}" Value="{Binding MovementText}" AccentColor="{StaticResource PartyCyan}" />
                    <controls:InfoTile Grid.Column="2" Caption="{x:Static res:AppResources.TileTime}" Value="{Binding TimeText}" AccentColor="{StaticResource PartyViolet}" />
                </Grid>

                <controls:PartyButton Grid.Row="3" Text="{x:Static res:AppResources.Next}" Command="{Binding ContinueCommand}" Margin="0,0,-5,-5" />
            </Grid>

            <!-- Touching (mockup 5) -->
            <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,16" IsVisible="{Binding IsTouching}">
                <Label Text="{Binding Header}" Style="{StaticResource Caption}" />
                <VerticalStackLayout Grid.Row="1" Spacing="10" VerticalOptions="Center">
                    <Label Text="{x:Static res:AppResources.TouchNow}" FontFamily="{StaticResource FontExtraBold}" FontSize="17" CharacterSpacing="3"
                           TextColor="{StaticResource PartyCyan}" HorizontalTextAlignment="Center" />
                    <Grid HorizontalOptions="Center" Margin="0,-40,0,-30">
                        <Label Text="{Binding CountdownText}" FontFamily="{StaticResource FontTitle}" FontSize="150" TextColor="{StaticResource PartyPink}"
                               HorizontalTextAlignment="Center" TranslationX="6" TranslationY="6" />
                        <Label Text="{Binding CountdownText}" FontFamily="{StaticResource FontTitle}" FontSize="150" TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                    <Grid WidthRequest="240" HeightRequest="8" HorizontalOptions="Center">
                        <BoxView Color="#2E2650" />
                        <BoxView Color="{StaticResource Primary}" AnchorX="0" ScaleX="{Binding CountdownProgress}" />
                    </Grid>
                    <Label Text="{Binding TouchLine}" FontSize="15" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                </VerticalStackLayout>
                <Button Grid.Row="2" Text="{x:Static res:AppResources.AbortRound}" Style="{StaticResource SecondaryButton}" Command="{Binding AbortRoundCommand}" />
            </Grid>

            <!-- Curtain (mockup 6) -->
            <Grid RowDefinitions="*,Auto" Padding="20,12,20,16" IsVisible="{Binding IsCurtain}">
                <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                    <Grid WidthRequest="116" HeightRequest="116" HorizontalOptions="Center" Margin="0,0,0,10">
                        <BoxView Color="{StaticResource PartyPink}" Margin="8,8,0,0" />
                        <Grid BackgroundColor="{StaticResource Primary}" Margin="0,0,8,8">
                            <controls:LineIcon Data="M3 3 L21 21 M10.6 6.1 A10 10 0 0 1 12 6 C17 6 20.5 9.5 22 12 C21.4 13 20.6 14 19.6 15 M14.1 14.2 A3 3 0 0 1 9.8 9.9 M6.5 7.6 C4.5 8.8 3 10.4 2 12 C3.5 14.5 7 18 12 18 C13.6 18 15 17.6 16.3 17"
                                               StrokeColor="{StaticResource OnPrimary}" StrokeWidth="2.2" IconSize="52" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                    <Label Text="{x:Static res:AppResources.HandPhone}" Style="{StaticResource BigTitle}" />
                    <Label Text="{Binding GuesserName}" Style="{StaticResource BigTitle}" TextColor="{StaticResource PartyCyan}" Margin="0,-10,0,0" />
                    <Label Text="{Binding CurtainHint}" FontSize="15" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="30,4" />
                </VerticalStackLayout>
                <controls:PartyButton Grid.Row="1" Text="{x:Static res:AppResources.Ready}" Command="{Binding ReadyCommand}" Margin="0,0,-5,-5" />
            </Grid>

            <!-- Session summary (mockup 9) -->
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16" Padding="20,12,20,16" IsVisible="{Binding IsSummary}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Header}" Style="{StaticResource Caption}" />
                    <Label Text="{x:Static res:AppResources.GameOver}" Style="{StaticResource ScreenTitle}" />
                </VerticalStackLayout>

                <FlexLayout Grid.Row="1" BindableLayout.ItemsSource="{Binding Podium}" Direction="Row" AlignItems="End" JustifyContent="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PodiumItem">
                            <VerticalStackLayout FlexLayout.Basis="33%" Spacing="6" Margin="4,0">
                                <controls:Avatar Name="{Binding Name}" Color="{Binding Color}" Emoji="{Binding Emoji}" Size="48" HorizontalOptions="Center" />
                                <Label Text="{Binding Name}" FontFamily="{StaticResource FontBold}" FontSize="15" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Points}" FontSize="13" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                                <Grid HeightRequest="{Binding BarHeight}" BackgroundColor="{Binding Color}">
                                    <Label Text="{Binding Place}" FontFamily="{StaticResource FontTitle}" FontSize="30" TextColor="{StaticResource OnPrimary}"
                                           HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <controls:AccentRow Caption="{x:Static res:AppResources.BestHit}" Value="{Binding BestHitText}" AccentColor="{StaticResource Primary}" />
                    <controls:AccentRow Caption="{x:Static res:AppResources.AverageMiss}" Value="{Binding AverageMissText}" AccentColor="{StaticResource PartyCyan}" />
                    <controls:AccentRow Caption="{x:Static res:AppResources.HardestZone}" Value="{Binding HardestZoneText}" AccentColor="{StaticResource PartyPink}" />
                    <controls:AccentRow Caption="{x:Static res:AppResources.BiggestMiss}" Value="{Binding BiggestMissText}" AccentColor="{StaticResource PartyViolet}" />
                </VerticalStackLayout>

                <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Button Text="{x:Static res:AppResources.Menu}" Style="{StaticResource SecondaryButton}" Command="{Binding MenuCommand}" VerticalOptions="Start" Padding="22,0" />
                    <controls:PartyButton Grid.Column="1" Text="{x:Static res:AppResources.NewGame}" Command="{Binding NewGameCommand}" Margin="0,0,-5,-5" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Confetti burst over everything (perfect hit, spec 13). -->
        <controls:ConfettiBurst x:Name="Confetti" />
    </Grid>
</ContentPage>

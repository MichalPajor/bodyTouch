<?xml version="1.0" encoding="UTF-8" ?>
<!-- Design tokens "Impreza – konfetti" (spec 13). The app has a dark theme only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Background">#0D0A1A</Color>
    <!-- Surface: #171329 at 90 % opacity -->
    <Color x:Key="Surface">#E6171329</Color>
    <Color x:Key="SurfaceSolid">#171329</Color>
    <Color x:Key="Border">#2E2650</Color>
    <Color x:Key="Text">#F4F2FF</Color>
    <Color x:Key="Muted">#B3ACD6</Color>
    <Color x:Key="Primary">#FF9A3C</Color>
    <Color x:Key="OnPrimary">#0D0A1A</Color>
    <Color x:Key="PartyPink">#FF3D9A</Color>
    <Color x:Key="PartyCyan">#22D3EE</Color>
    <Color x:Key="PartyViolet">#8B5CF6</Color>
    <Color x:Key="Pin">#5B8CFF</Color>
    <Color x:Key="Mannequin">#C8CCD6</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PartyPinkBrush" Color="{StaticResource PartyPink}" />

    <!-- Font aliases registered in MauiProgram -->
    <x:String x:Key="FontTitle">UnboundedExtraBold</x:String>
    <x:String x:Key="FontTitleBold">UnboundedBold</x:String>
    <x:String x:Key="FontRegular">JakartaRegular</x:String>
    <x:String x:Key="FontSemiBold">JakartaSemiBold</x:String>
    <x:String x:Key="FontBold">JakartaBold</x:String>
    <x:String x:Key="FontExtraBold">JakartaExtraBold</x:String>
</ResourceDictionary>
